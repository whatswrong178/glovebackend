# ──────────────────────────────────────────────────────────
# MediGlove ERP — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────

# Supabase — exposed to frontend (safe to include in client bundle)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — backend only (Edge Functions / server-side RPCs)
# DO NOT prefix with VITE_ — this key MUST NEVER reach the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-DO-NOT-EXPOSE-TO-FRONTEND"

# Google Gemini (AI product catalogue parser — T-03.1)
# Called from a Supabase Edge Function, not the frontend
GEMINI_API_KEY="your-gemini-api-key"

# Make.com Webhook (dunning engine, month-end snapshot — T-08.1/8.3)
MAKE_WEBHOOK_URL="https://hook.eu1.make.com/your-webhook-id"

# Shared secret for authenticating Make.com inbound webhook calls
SYSTEM_SECRET_KEY="your-custom-secret-for-webhook-auth"

# Resend API (transactional email — T-01.4)
# Edge Function only — never expose to frontend
RESEND_API_KEY="your-resend-api-key"
